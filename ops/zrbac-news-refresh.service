[Unit]
Description=Public bounded refresh trigger for the news website
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=GH_PROMPT_DISABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/zrbac-news-refresh/news_refresh_api.py
StateDirectory=zrbac-news-refresh
StateDirectoryMode=0700
ReadWritePaths=/var/lib/zrbac-news-watchdog
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=160M
TasksMax=32

[Install]
WantedBy=multi-user.target
